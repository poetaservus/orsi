{
  "provider_name": "OpenRouter Free",
  "base_url": "https://openrouter.ai/api/v1",
  "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
  "fallback_models": [
    "inclusionai/ling-3.0-flash-fin:free",
    "nvidia/nemotron-3.5-lightning:free"
  ],
  "api_key_environment": "OPENROUTER_API_KEY",
  "extra_headers": {
    "HTTP-Referer": "https://github.com/poetaservus/orsi",
    "X-OpenRouter-Title": "O.R.S.I"
  },
  "include_tool_strict": false,
  "tool_choice": null,
  "context_length": 32768,
  "temperature": 0.1,
  "max_tokens": 4096,
  "timeout_seconds": 90,
  "model_step_timeout_seconds": 300,
  "max_retries": 2,
  "default_mode": "local",
  "fallback_to_local": false
}
